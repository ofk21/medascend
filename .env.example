# ---- Database (PostgreSQL) ----
# e.g. Neon / Supabase / Railway / local docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medascend?schema=public"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# ---- Seed admin (used by `npm run db:seed`) ----
ADMIN_EMAIL="admin@medascend.app"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="MedAscend Admin"

# ---- Stripe (optional). Without keys, checkout shows a "payments coming soon" notice and admins can grant access manually ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- AI Tutor (optional). An Anthropic API key enables the in-question AI tutor ----
ANTHROPIC_API_KEY=""

# ---- Email (optional). Resend API key enables password-reset emails; without it the reset link is printed to the server log ----
RESEND_API_KEY=""
EMAIL_FROM="MedAscend <noreply@medascend.app>"
